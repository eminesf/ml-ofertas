generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Offer {
  id                 String    @id @default(cuid())
  externalId         String    @unique
  provider           String
  title              String
  couponAmount       String?
  couponCode         String?
  couponExpiresAt    DateTime?
  originalPrice      Float
  salePrice          Float
  discountPct        Int
  imageUrl           String?
  productUrl         String
  affiliateUrl       String
  category           String?
  rating             Float?
  aiScore            Int?
  suggestedHighlight String?
  telegramMessage    String?
  whatsappMessage    String?
  source             String    @default("offers-page")
  upvotes            Int       @default(0)
  shortCode          String?   @unique   // link curto do site: /r/{shortCode}
  clicks             Int       @default(0)
  sourcePrice        Float?             // preço anunciado pela fonte (canal/grupo), com cupom/Pix
  createdAt          DateTime  @default(now())
  posts              Post[]
}

model Coupon {
  id        String    @id @default(cuid())
  provider  String
  code      String
  discount  String
  minValue    Float?
  maxDiscount Float?
  category    String?
  expiresAt DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@unique([code, provider])
}

model Post {
  id              String    @id @default(cuid())
  offerId         String
  offer           Offer     @relation(fields: [offerId], references: [id])
  channel         String
  message         String
  whatsappMessage String?
  sentAt          DateTime  @default(now())
  repostedAt      DateTime?
  success         Boolean   @default(true)
  price           Float?    // preço efetivo no momento do post (fonte ou loja) — detecta preço novo
  couponCode      String?   // cupom no momento do post — detecta cupom novo
}

// Último preço visto de cada produto de feed sem preço "de" (ex: Kabum via Awin).
// Queda relevante entre dois scrapes vira oferta — o preço anterior faz papel de originalPrice.
model FeedPrice {
  externalId String   @id
  provider   String
  price      Float
  updatedAt  DateTime @updatedAt

  @@index([provider])
}

// Um registro por clique no link curto /r/{code} (robôs de prévia não contam).
// src = origem: t (canal Telegram), w (grupo Tech & TCG), a (grupo Achadinhos), null = site.
// provider/offerId ficam soltos (sem relação) para a estatística sobreviver à limpeza de ofertas.
model Click {
  id       String   @id @default(cuid())
  offerId  String
  provider String
  src      String?
  at       DateTime @default(now())

  @@index([at])
  @@index([offerId])
}
