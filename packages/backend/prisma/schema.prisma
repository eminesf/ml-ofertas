generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Offer {
  id                 String    @id @default(cuid())
  externalId         String    @unique
  provider           String
  title              String
  couponAmount       String?
  couponCode         String?
  couponExpiresAt    DateTime?
  originalPrice      Float
  salePrice          Float
  discountPct        Int
  imageUrl           String?
  productUrl         String
  affiliateUrl       String
  category           String?
  rating             Float?
  aiScore            Int?
  suggestedHighlight String?
  telegramMessage    String?
  whatsappMessage    String?
  source             String    @default("offers-page")
  upvotes            Int       @default(0)
  createdAt          DateTime  @default(now())
  posts              Post[]
}

model Coupon {
  id        String    @id @default(cuid())
  provider  String
  code      String
  discount  String
  minValue    Float?
  maxDiscount Float?
  category    String?
  expiresAt DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@unique([code, provider])
}

model Post {
  id              String    @id @default(cuid())
  offerId         String
  offer           Offer     @relation(fields: [offerId], references: [id])
  channel         String
  message         String
  whatsappMessage String?
  sentAt          DateTime  @default(now())
  repostedAt      DateTime?
  success         Boolean   @default(true)
}

// Último preço visto de cada produto de feed sem preço "de" (ex: Kabum via Awin).
// Queda relevante entre dois scrapes vira oferta — o preço anterior faz papel de originalPrice.
model FeedPrice {
  externalId String   @id
  provider   String
  price      Float
  updatedAt  DateTime @updatedAt

  @@index([provider])
}
